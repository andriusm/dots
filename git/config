[color]
	ui = auto
[alias]
	fap = fetch --all --prune
	pom = "!f() { b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); [ -z \"$b\" ] && b=$(git remote show origin | sed -n 's/.*HEAD branch: //p'); git pull origin \"$b\" \"$@\"; }; f"
	dm = "!f() { b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); [ -z \"$b\" ] && b=$(git remote show origin | sed -n 's/.*HEAD branch: //p'); git diff \"$b\" \"$@\"; }; f"

	wta = worktree add
	wtr = worktree remove
	wtl = worktree list
	
	a = add
	c = commit
	br = branch
	co = checkout
	amend = commit --amend
	nsm = "!f() { b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); [ -z \"$b\" ] && b=$(git remote show origin | sed -n 's/.*HEAD branch: //p'); git diff --name-status \"$b\" \"$@\"; }; f"

	st = status
	s = status --short --untracked-files

	r = rebase
	ri = rebase --interactive
	rc = rebase --continue
	rs = rebase --skip
	di = diff
	dc = diff --cached
	ds = diff --stat=160,120
	dh1 = diff HEAD~1
	l = log --graph --abbrev-commit --date=relative
	head = !git l -1
	h = !git head
	la = !git l --all
	b = branch --verbose
	re = remote --verbose
	redo = reset --soft HEAD^
	purge = !git reset --hard && git clean -fd
	listconf = config --global --list
	ctags = !.git/hooks/ctags
	spull = svn rebase
	spush = svn dcommit
[format]
	pretty = format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset
[core]
	editor = nvim
	autocrlf = input
	safecrlf = false
	excludesfile = ~/.config/git/global_ignore
	quotepath = false
	commitGraph = true
	pager = delta
	ignoreCase = true
[diff]
	guitool = kdiff3
[merge]
	tool = kdiff3
	conflictstyle = diff3
[credential]
[apply]
	whitespace = nowarn

[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[gpg]
	program = gpg

; [url "git@github.com:"]
; 	insteadOf = https://github.com/

[pull]
	ff = only
[gc]
	writeCommitGraph = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true

	#syntax-theme = GitHub
	zero-style = syntax
[diff]
	colorMoved = default

[http]
	sslCAinfo = /etc/ssl/certs/ca-certificates.crt

# vim:ft=gitconfig
[url "git@github.com:"]
	insteadOf = https://github.com/
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = master
